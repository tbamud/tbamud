# tbaMUD Makefile.in - Makefile template used by 'configure'
# Clean-up provided by seqwith.

# C compiler and configure-detected flags
CC = @CC@
CONFIG_CFLAGS = @CFLAGS@
MYFLAGS = @MYFLAGS@

# Flags for profiling (see hacker.doc for more information)
PROFILE =

# Build modes:
#   make                 -> production build
#   make BUILD_MODE=prod -> optimized build without memory debugging
#   make BUILD_MODE=dev  -> unoptimized build with debug symbols and MEMORY_DEBUG
BUILD_MODE ?= prod
BASE_CFLAGS := $(filter-out -g% -O%,$(CONFIG_CFLAGS))

ifeq ($(BUILD_MODE),dev)
MODE_CFLAGS = -g3 -O0 -DMEMORY_DEBUG
else ifeq ($(BUILD_MODE),prod)
MODE_CFLAGS = -O2
else
$(error BUILD_MODE must be dev or prod)
endif

##############################################################################
# Do Not Modify Anything Below This Line (unless you know what you're doing) #
##############################################################################

BINDIR = ../bin
BUILD_FLAGS_FILE = .build-flags

CFLAGS = $(BASE_CFLAGS) $(MODE_CFLAGS) $(MYFLAGS) $(PROFILE)
LIBS = @LIBS@ @CRYPTLIB@ @NETLIB@

SRCFILES := $(shell ls *.c | sort)
OBJFILES := $(patsubst %.c,%.o,$(SRCFILES))

.PHONY: default all utils circle clean FORCE

default: all

all: .accepted
	$(MAKE) $(BINDIR)/circle
	$(MAKE) utils

.accepted:
	@./licheck @MORE@

utils: .accepted
	(cd util; $(MAKE) all)

circle:
	$(MAKE) $(BINDIR)/circle

$(BINDIR)/circle: $(OBJFILES)
	$(CC) -o $(BINDIR)/circle $(PROFILE) $(OBJFILES) $(LIBS)

$(OBJFILES): $(BUILD_FLAGS_FILE)

$(BUILD_FLAGS_FILE): FORCE
	@printf '%s\n' 'BUILD_MODE=$(BUILD_MODE)' 'CC=$(CC)' 'CFLAGS=$(CFLAGS)' 'LIBS=$(LIBS)' > $@.tmp
	@if test -r $@ && cmp -s $@ $@.tmp; then rm -f $@.tmp; else mv $@.tmp $@; fi

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f *.o depend $(BUILD_FLAGS_FILE) $(BUILD_FLAGS_FILE).tmp

# Dependencies for the object files (automagically generated with gcc -MM)
depend:
	$(CC) $(CFLAGS) -MM *.c > depend

FORCE:

ifneq ($(MAKECMDGOALS),clean)
-include depend
endif
